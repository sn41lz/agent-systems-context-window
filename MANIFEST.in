include Makefile Dockerfile docker-compose.yml PRODUCTION_CHECKLIST.md
include requirements.lock requirements-dev.lock requirements-build.lock
include .env.example .dockerignore .gitignore
include README.es.md LICENSE THIRD_PARTY_NOTICES.md
recursive-include docs *.md *.html *.json *.jsonl
recursive-include examples *.py *.md *.jsonl
recursive-include scripts *.py
